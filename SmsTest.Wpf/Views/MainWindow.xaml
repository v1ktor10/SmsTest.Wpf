<Window
    x:Class="SmsTest.Wpf.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:SmsTest.Wpf.Controls"
    mc:Ignorable="d"
    Title="Тестовое WPF-приложение для SmartMealService"
    Height="420" Width="820"
    MinHeight="320" MinWidth="600"
    WindowStartupLocation="CenterScreen"
    FontFamily="Segoe UI"
    FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/DataGridStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── DataGrid ──────────────────────────── -->
        <Grid Grid.Row="0">
            
            <Border
                BorderBrush="#C8C8C8"
                BorderThickness="1"
                Background="White">

                <DataGrid ItemsSource="{Binding Items}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="False"
                          SelectionMode="Single"
                          SelectionUnit="Cell"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#EBEBEB"
                          VerticalGridLinesBrush="#EBEBEB"
                          HeadersVisibility="Column"
                          RowHeaderWidth="22"
                          Background="White"
                          BorderThickness="0"
                          ColumnHeaderHeight="32"
                          RowHeight="30"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          EnableRowVirtualization="True">

                    <DataGrid.Columns>

                        <!-- Поле (read-only) -->
                        <DataGridTextColumn Header="Поле"
                                            Binding="{Binding Name, Mode=OneWay}"
                                            Width="220"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="10,0" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="#444444" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Значение (editable) -->
                        <DataGridTextColumn Header="Значение"
                                            Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="10,0" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="VerticalAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- Комментарий (editable) -->
                        <DataGridTextColumn Header="Комментарий"
                                            Binding="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="10,0" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="#777777" />
                                    <Setter Property="FontStyle" Value="Italic" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="VerticalAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border CornerRadius="8"
                    Background="#CCFFFFFF"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                    Panel.ZIndex="10">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0">
                    <controls:LoadingSpinner HorizontalAlignment="Center" />
                    <TextBlock Text="Загрузка..."
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"
                               FontSize="12"
                               Foreground="#555555" />
                </StackPanel>
            </Border>

        </Grid>

        <!-- ── Status bar ──────────────────────────────────────────── -->
        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Margin="2,8,0,0"
                   FontSize="11.5"
                   Foreground="#666666"
                   TextTrimming="CharacterEllipsis" />

    </Grid>
</Window>